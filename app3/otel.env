# Zero-code OpenTelemetry config (loaded by `python start.py`).
# Existing environment variables are not overwritten.

OTEL_SERVICE_NAME=zero-code-python
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Limit auto-instrumentation to the Flask request path (plus stdlib logging).
# Bootstrap also installs grpc/requests/urllib instrumentations that we do not want.
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=asyncio,click,dbapi,grpc,jinja2,requests,sqlite3,threading,urllib,urllib3

# Export Flask/Werkzeug logs over OTLP and attach trace_id / span_id.
OTEL_PYTHON_LOG_AUTO_INSTRUMENTATION=true
OTEL_PYTHON_LOG_CORRELATION=true

# Faster metric export for local demos (default interval is 60s).
# Timeout must be less than or equal to the interval.
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRIC_EXPORT_TIMEOUT=5000
OTEL_SEMCONV_STABILITY_OPT_IN=http
OTEL_LOG_LEVEL=warn
