        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(traffic_volume_request_total{job=\"manual-python\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "requests",
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "error_rate divided by traffic_volume. error_rate increments when the status is 400 or higher, including 404. Shows 0 while requests succeed.",
