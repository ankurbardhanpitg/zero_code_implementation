      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "(sum(rate(error_rate_request_total{job=\"manual-python\", http_route=~\"$route\"}[$__rate_interval])) or (sum(rate(traffic_volume_request_total{job=\"manual-python\", http_route=~\"$route\"}[$__rate_interval])) * 0)) / clamp_min(sum(rate(traffic_volume_request_total{job=\"manual-python\", http_route=~\"$route\"}[$__rate_interval])), 1e-9)",
