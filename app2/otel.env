# Zero-code OpenTelemetry config (loaded by `npm start` via --env-file).
# Existing environment variables are not overwritten.

OTEL_SERVICE_NAME=zero-code-node-houses
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Skip cloud resource detectors so local startup is not delayed.
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,express,router,runtime-node

# Faster metric export for local demos (default interval is 60s).
# Timeout must be less than or equal to the interval.
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRIC_EXPORT_TIMEOUT=5000
OTEL_SEMCONV_STABILITY_OPT_IN=http
OTEL_LOG_LEVEL=warn
